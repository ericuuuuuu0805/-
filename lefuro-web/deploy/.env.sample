# deploy/.env.sample — デプロイ用の認証情報テンプレート
#
# 使い方:
#   cp deploy/.env.sample deploy/.env  して実値を記入。
#   deploy/.env は .gitignore 済み（コミットされない）。
#   deploy.sh が読み込む。
#
# ※ さくらの会員/サーバ/DB 各パスワードは正本(Google Drive)を参照。

# --- FTP（ファイル配置用）---
FTP_HOST=lod-be.sakura.ne.jp
FTP_USER=lod-be
FTP_PASS=ここにFTP/サーバパスワードを記入
FTP_REMOTE_DIR=www/www2          # 公開フォルダ = ~/www/www2

# --- 公開URL（疎通確認用）---
SITE_HOST=www2.le-furo.com
SITE_IP=219.94.155.251
SITE_SCHEME=http                  # SSL 発行後は https へ
